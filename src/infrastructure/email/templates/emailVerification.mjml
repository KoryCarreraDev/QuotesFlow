<mjml lang="es">
  <mj-include path="./partials/head.mjml" />
  <mj-body background-color="#f3f4f6">
    <mj-include path="./partials/header.mjml" />
    <mj-section background-color="#ffffff" border-radius="8px" padding="24px">
      <mj-column>
        <mj-text>Hola, {{ firstName }}:</mj-text>
        <mj-text>Para empezar a usar QuotesFlow, confirma que este es tu correo.</mj-text>
        <mj-button href="{{actionUrl}}">Confirmar mi correo</mj-button>
        <mj-text font-size="13px" color="#6b7280"
          >El enlace vence en {{ expiresInHours }} horas y solo sirve una vez. Si el botón no funciona, copia esta
          dirección en tu navegador: {{ actionUrl }}</mj-text
        >
      </mj-column>
    </mj-section>
    <mj-include path="./partials/footer.mjml" />
  </mj-body>
</mjml>

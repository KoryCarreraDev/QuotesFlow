<mj-head>
  <mj-title>QuotesFlow</mj-title>
  <mj-preview>{{ preview }}</mj-preview>
  <mj-attributes>
    <mj-all font-family="Helvetica, Arial, sans-serif" />
    <mj-text font-size="15px" line-height="24px" color="#1f2933" />
    <mj-button
      background-color="#1d4ed8"
      color="#ffffff"
      font-size="15px"
      font-weight="bold"
      border-radius="6px"
      inner-padding="12px 24px"
    />
  </mj-attributes>
</mj-head>

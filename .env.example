# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/saas_comerciales?schema=public"

# Docker Compose de desarrollo (docker-compose.yml)
POSTGRES_USER="usuario"
POSTGRES_PASSWORD="password"
POSTGRES_DB="saas_comerciales"

# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres: la API no arranca sin él (H1).
# Se deja vacío a propósito para que nadie use un valor copiado de aquí. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
# Vida del token de acceso: número + unidad (ms, s, m, h, d, w, y). Por defecto 15m (D-09).
JWT_EXPIRATION="15m"
# Vida absoluta de una sesión (refresh token rotatorio). Por defecto 7d.
REFRESH_TOKEN_EXPIRATION="7d"

# CORS: orígenes exactos del frontend, separados por comas (esquema + host, sin ruta). Vacío = ninguno.
# Nunca "*": la API usa cookie de sesión.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Proxies de confianza delante de la API (balanceador, CDN). 0 en local; en producción, los que haya.
TRUST_PROXY=0

# Límites de peticiones por IP cada 15 minutos (opcionales; estos son los valores por defecto).
RATE_LIMIT_GLOBAL_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# Nivel de los logs técnicos: debug, info, warn o error. Por defecto info.
LOG_LEVEL=info

# Servidor
PORT=4000
# Obligatorio: development, test o production.
NODE_ENV=development
# Correo transaccional (F2-T01). resend | log (escribe el correo en el log) | memory (solo tests).
# En producción solo vale resend, con RESEND_API_KEY y EMAIL_FROM. La clave es un secreto: no se copia aquí.
EMAIL_PROVIDER=log
RESEND_API_KEY=""
EMAIL_FROM="QuotesFlow <no-reply@localhost>"
# URL del frontend para los enlaces de los correos, sin barra final (https en producción).
APP_BASE_URL="http://localhost:5173"

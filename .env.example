# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/saas_comerciales?schema=public"

# Docker Compose de desarrollo (docker-compose.yml)
POSTGRES_USER="usuario"
POSTGRES_PASSWORD="password"
POSTGRES_DB="saas_comerciales"

# JWT_SECRET es obligatorio y debe tener al menos 32 caracteres: la API no arranca sin él (H1).
# Se deja vacío a propósito para que nadie use un valor copiado de aquí. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=""
# Número + unidad (ms, s, m, h, d, w, y). Por defecto 7d.
JWT_EXPIRATION="7d"

# Servidor
PORT=4000
# Obligatorio: development, test o production.
NODE_ENV=development
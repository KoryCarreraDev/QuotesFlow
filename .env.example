# Base de datos
DATABASE_URL="postgresql://usuario:password@localhost:5432/saas_comerciales?schema=public"

# Docker Compose de desarrollo (docker-compose.yml)
POSTGRES_USER="usuario"
POSTGRES_PASSWORD="password"
POSTGRES_DB="saas_comerciales"

# JWT (obligatorio; generar uno propio, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET="una-clave-secreta-muy-larga"
JWT_EXPIRATION="7d"

# Servidor
PORT=4000
NODE_ENV=development
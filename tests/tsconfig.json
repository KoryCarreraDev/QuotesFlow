{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["../src/*"],
      "@tests/*": ["./*"]
    }
  },
  "include": ["./**/*.ts", "../src/**/*.ts", "../scripts/**/*.ts", "../vitest.config.ts"]
}
